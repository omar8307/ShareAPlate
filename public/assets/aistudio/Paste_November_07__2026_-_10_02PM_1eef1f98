<!-- JAVASCRIPT LOGIC & MICRO-INTERACTIONS -->
<script>
    // Tab switching state
    function switchRoleTab(tabKey) {
      const allTabs = ['marketplace', 'donor-hub', 'ngo-portal', 'volunteer-task', 'impact-analytics'];
      
      allTabs.forEach(t => {
        const btn = document.getElementById('tab-btn-' + t);
        const panel = document.getElementById('panel-' + t);
        
        if (t === tabKey) {
          if (btn) {
            btn.className = "role-tab-btn flex items-center gap-2 px-3.5 py-2 rounded-lg font-label-md text-label-md transition-all bg-surface-container-lowest text-primary shadow-sm font-bold";
          }
          if (panel) {
            panel.classList.remove('hidden');
            panel.classList.add('flex');
          }
        } else {
          if (btn) {
            btn.className = "role-tab-btn flex items-center gap-2 px-3.5 py-2 rounded-lg font-label-md text-label-md transition-all text-on-surface-variant hover:text-on-surface";
          }
          if (panel) {
            panel.classList.add('hidden');
            panel.classList.remove('flex');
          }
        }
      });
    }

    function scrollToView(elemId) {
      const el = document.getElementById(elemId);
      if (el) {
        el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    // Toggle between Grid View and Map View on Marketplace Tab
    function toggleMarketView(viewType) {
      const gridContainer = document.getElementById('marketplace-grid-container');
      const mapContainer = document.getElementById('marketplace-map-container');
      const btnGrid = document.getElementById('view-toggle-grid');
      const btnMap = document.getElementById('view-toggle-map');

      if (viewType === 'grid') {
        gridContainer.classList.remove('hidden');
        gridContainer.classList.add('grid');
        mapContainer.classList.add('hidden');
        mapContainer.classList.remove('flex');

        btnGrid.className = "flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-container-lowest text-primary shadow-xs font-label-sm text-label-sm font-bold";
        btnMap.className = "flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-on-surface-variant font-label-sm text-label-sm hover:text-on-surface font-semibold";
      } else {
        gridContainer.classList.add('hidden');
        gridContainer.classList.remove('grid');
        mapContainer.classList.remove('hidden');
        mapContainer.classList.add('flex');

        btnMap.className = "flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-container-lowest text-primary shadow-xs font-label-sm text-label-sm font-bold";
        btnGrid.className = "flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-on-surface-variant font-label-sm text-label-sm hover:text-on-surface font-semibold";
      }
    }

    // Distance Radius Slider update
    function updateRadiusLabel(val) {
      const label = document.getElementById('radius-val');
      if (label) {
        label.innerText = val + ' km';
      }
    }

    // Filter Marketplace Cards Logic
    function filterFoodListings() {
      const searchVal = (document.getElementById('market-search-input').value || '').toLowerCase();
      const catVal = document.getElementById('filter-category').value;
      const urgVal = document.getElementById('filter-urgency').value;
      const dietVal = document.getElementById('filter-dietary').value;
      const maxDist = parseFloat(document.getElementById('filter-distance').value || '25');

      const cards = document.querySelectorAll('.food-card');
      let visibleCount = 0;

      cards.forEach(card => {
        const title = (card.getAttribute('data-title') || '').toLowerCase();
        const donor = (card.getAttribute('data-donor') || '').toLowerCase();
        const cat = card.getAttribute('data-category');
        const urg = card.getAttribute('data-urgency');
        const diet = card.getAttribute('data-dietary');
        const dist = parseFloat(card.getAttribute('data-distance') || '0');

        const matchesSearch = title.includes(searchVal) || donor.includes(searchVal);
        const matchesCat = (catVal === 'all' || cat === catVal);
        const matchesUrg = (urgVal === 'all' || urg === urgVal);
        const matchesDiet = (dietVal === 'all' || diet === dietVal);
        const matchesDist = dist <= maxDist;

        if (matchesSearch && matchesCat && matchesUrg && matchesDiet && matchesDist) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      const noRes = document.getElementById('no-results-state');
      if (visibleCount === 0) {
        if (noRes) noRes.classList.remove('hidden');
      } else {
        if (noRes) noRes.classList.add('hidden');
      }
    }

    function resetMarketplaceFilters() {
      document.getElementById('market-search-input').value = '';
      document.getElementById('filter-category').value = 'all';
      document.getElementById('filter-urgency').value = 'all';
      document.getElementById('filter-dietary').value = 'all';
      document.getElementById('filter-distance').value = 10;
      updateRadiusLabel(10);
      filterFoodListings();
      toggleMarketView('grid');
    }

    // AI Description Generator in Donor Tab
    function runAIDescriptionGenerator() {
      const name = document.getElementById('post-food-name').value || 'Steamed Basmati Rice & Dal Makhani';
      const cat = document.getElementById('post-category').value;
      const qty = document.getElementById('post-quantity-kg').value || '25';
      const storage = document.getElementById('post-storage').value;

      const descBox = document.getElementById('post-ai-description');
      descBox.value = `[AI FSSAI COMPLIANCE CHECK]\nItem: ${name} (${qty} kg / ~${Math.round(qty * 3.2)} meals). Packaged under strict hot-chain protocol (${storage}). Tested core temp >65°C. No dairy spoilage risk detected within 3.5 hrs. Safe consumption window through 23:00 hrs tonight. Good Samaritan Liability Clause active.`;
    }

    // Guest footfall simulation slider
    function updateGuestSimulation(val) {
      const footfallEl = document.getElementById('footfall-val');
      const noteEl = document.getElementById('predicted-surplus-note');
      if (footfallEl) footfallEl.innerText = val + ' Guests';
      const estSurplus = Math.round(val * 0.09);
      if (noteEl) noteEl.innerText = `Estimated surplus: ${estSurplus} kg (~${Math.round(estSurplus * 3)} meals)`;
    }

    // Post Donation Handler
    function handleDonationSubmit(e) {
      e.preventDefault();
      const foodName = document.getElementById('post-food-name').value;
      const qtyKg = document.getElementById('post-quantity-kg').value;
      const servings = document.getElementById('post-servings').value;
      const loc = document.getElementById('post-location').value;

      alert(`Success! "${foodName}" (${qtyKg} kg / ${servings} meals) posted live from ${loc}. Verified NGOs within 6 km have been alerted via push notification!`);
      switchRoleTab('marketplace');
      scrollToView('tab-content');
    }

    // Post NGO Demand Handler
    function handleNGORequestSubmit(e) {
      e.preventDefault();
      const count = document.getElementById('ngo-req-count').value;
      alert(`Broadcasting requirement for ${count} meals to caterers across Bengaluru South & East. You will receive OTP match confirmations as kitchens approve!`);
    }

    // Claim Modal
    let activeClaimItem = '';
    function openClaimModal(itemName, donor, qty) {
      activeClaimItem = itemName;
      document.getElementById('modal-claim-item-name').innerText = itemName;
      document.getElementById('modal-claim-donor').innerText = donor;
      document.getElementById('modal-claim-qty').innerText = qty;
      document.getElementById('modal-otp-result').classList.add('hidden');
      document.getElementById('modal-confirm-btn').classList.remove('hidden');

      const modal = document.getElementById('claim-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeClaimModal() {
      const modal = document.getElementById('claim-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function executeClaimSubmission() {
      document.getElementById('modal-otp-result').classList.remove('hidden');
      document.getElementById('modal-confirm-btn').classList.add('hidden');
      setTimeout(() => {
        // Also advance volunteer task status to demo seamless state
        document.getElementById('verify-otp-input').value = 'SAP-9142';
      }, 500);
    }

    // Safety & Allergen Modal
    function showSafetyModal(title, donor, desc) {
      document.getElementById('safety-modal-title').innerText = title;
      document.getElementById('safety-modal-donor').innerText = donor;
      document.getElementById('safety-modal-desc').innerText = desc;

      const modal = document.getElementById('safety-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeSafetyModal() {
      const modal = document.getElementById('safety-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    // Timeline Modal
    function showTimelineModal(donor, item) {
      document.getElementById('timeline-modal-subtitle').innerText = `Real-time custody tracking for ${item} from ${donor}`;
      const modal = document.getElementById('timeline-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeTimelineModal() {
      const modal = document.getElementById('timeline-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    // Volunteer Task Center Simulator
    let missionStage = 1;
    function advanceRescueMission() {
      const otp = (document.getElementById('verify-otp-input').value || '').trim();
      if (!otp) {
        alert('Please enter or scan verification token.');
        return;
      }

      if (missionStage === 1) {
        // Transition to In-Transit
        missionStage = 2;
        document.getElementById('step-card-1').className = "p-4 rounded-xl bg-surface-container text-on-surface flex flex-col gap-2 transition-all";
        document.getElementById('step-1-icon').innerText = 'check_circle';
        document.getElementById('step-card-2').className = "p-4 rounded-xl bg-primary-container text-on-primary flex flex-col gap-2 shadow-sm transition-all";
        document.getElementById('step-2-icon').innerText = 'radio_button_checked';

        document.getElementById('mission-status-pill').className = "px-3 py-1 rounded-full bg-secondary-container text-on-secondary-container font-label-sm text-label-sm font-bold flex items-center gap-1.5";
        document.getElementById('mission-status-text').innerText = 'Stage 2: Food In Transit (Temperature Audited: 67.4°C)';
        document.getElementById('mission-btn-text').innerText = 'Confirm NGO Shelter Delivery';
        alert('Pickup verified at Grand Palace Caterers! Status set to [IN TRANSIT]. Route map active.');
      } else if (missionStage === 2) {
        // Transition to Delivered
        missionStage = 3;
        document.getElementById('step-card-2').className = "p-4 rounded-xl bg-surface-container text-on-surface flex flex-col gap-2 transition-all";
        document.getElementById('step-2-icon').innerText = 'check_circle';
        document.getElementById('step-card-3').className = "p-4 rounded-xl bg-primary-container text-on-primary flex flex-col gap-2 shadow-sm transition-all";
        document.getElementById('step-3-icon').innerText = 'check_circle';

        document.getElementById('mission-status-pill').className = "px-3 py-1 rounded-full bg-primary/20 text-primary font-label-sm text-label-sm font-bold flex items-center gap-1.5";
        document.getElementById('mission-status-text').innerText = 'Stage 3: Delivered & Verified by NGO (Mission Complete)';
        document.getElementById('mission-btn-text').innerText = 'Mission Completed (100% Impact)';
        document.getElementById('mission-action-btn').disabled = true;
        alert('Mission Completed! Feeding Hope Shelter confirmed delivery of 85 meals. +50 Volunteer Points added to Kavitha S.');
      }
    }
  </script>
